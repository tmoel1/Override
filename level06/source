#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ptrace.h>

static int auth(char *login, int serial)
{
	int length;
	int expected;
	int index;

	login[strcspn(login, "\n")] = '\0';
	length = strnlen(login, 32);
	if (length <= 5)
		return (1);
	if (ptrace(PTRACE_TRACEME, 0, NULL, NULL) == -1)
		return (1);
	expected = ((signed char)login[3] ^ 0x1337) + 0x5eeded;
	for (index = 0; index < length; index++)
	{
		if ((unsigned char)login[index] <= 0x1f)
			return (1);
		expected += ((signed char)login[index] ^ expected) % 0x539;
	}
	return (serial != expected);
}

int main(int argc, char **argv)
{
	char login[32];
	int serial;

	puts("***********************************");
	puts("*               level06           *");
	puts("***********************************");
	printf("-> Enter Login: ");
	fgets(login, sizeof(login), stdin);
	puts("***********************************");
	puts("***** NEW ACCOUNT DETECTED ********");
	puts("***********************************");
	printf("-> Enter Serial: ");
	scanf("%u", &serial);
	if (auth(login, serial) == 0)
	{
		puts("Authenticated!");
		system("/bin/sh");
		return (0);
	}
	return (1);
}