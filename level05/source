#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void)
{
	char input[100];
	size_t index;

	fgets(input, sizeof(input), stdin);
	for (index = 0; index < strlen(input); index++)
	{
		if (input[index] > '@' && input[index] <= 'Z')
			input[index] ^= 0x20;
	}
	printf(input);
	exit(0);
}