#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void)
{
	char user_name[100] = {0};
	char stored_password[41] = {0};
	char entered_password[100] = {0};
	FILE *password_file;
	int bytes_read;

	password_file = fopen("/home/users/level03/.pass", "r");
